# ── mtmon — copy to .env, fill, then `docker compose up -d` ─────────────────────
# Dashboard/ API secret (session signing). Generate one per host:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
MTMON_SECRET_KEY=__GENERATE__

# Admin token for the dashboard login. Generate something long and random:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# If empty, the server generates one and writes it to data/.admin_token (check
# the container logs after first boot).
MTMON_ADMIN_TOKEN=__GENERATE__

# on = first heartbeat from an unknown agent auto-registers it (convenient first boot).
# off = you must register agents by hand (POST /api/register) before they can send data.
MTMON_AGENT_REGISTRATION=off

# Telegram alerts (optional). Leave empty to disable.
MTMON_TELEGRAM_TOKEN=
MTMON_TELEGRAM_CHAT_ID=

# Host port (container port is fixed 8080). Default shown; change if 8080 is busy.
MTMON_PORT=8080

# ── TLS ────────────────────────────────────────────────────────────────────────
# WAJIB kalau server ini internet-facing. Token admin + screenshot RDP Anda
# berjalan plaintext tanpa TLS — bisa di-sniff di jalur.
# Tanpa domain: MTMON_TLS=on membuat self-signed cert otomatis (browser warning
# 1x, klik "lanjutkan"). Dengan domain: arahkan DNS lalu isi MTMON_TLS_NAMES.
MTMON_TLS=on
MTMON_TLS_NAMES=monitor.contoh.com,127.0.0.1
# Atau pakai cert sendiri (Let's Encrypt / Caddy):
# MTMON_TLS_CERT=/full/path/cert.pem
# MTMON_TLS_KEY=/full/path/key.pem

# ── per-agent keys ──────────────────────────────────────────────────────────────
# Canonical form (recommended — agent ids can contain dashes/uppercase safely):
#   MTMON_AGENT_KEYS="rdp-01:k1-xxxx,rdp-02:k2-yyyy"
# The key in mt-agent/config.json on each Windows box MUST match. Only sha256(key)
# is stored in the database, never the key itself.
MTMON_AGENT_KEYS="rdp-01:__KEY1__,rdp-02:__KEY2__"

# ── threshold overrides (optional — defaults are baked in) ─────────────────────
# MTMON_ALERT_CPU=90
# MTMON_ALERT_MEM=92
# MTMON_ALERT_DISK=95
# MTMON_ALERT_MARGIN_LEVEL=120
# MTMON_ALERT_OFFLINE_SEC=90
# MTMON_ALERT_COOLDOWN_MIN=30
# MTMON_ALERT_NO_TERMINAL=true
# MTMON_RETENTION_DAYS=30
# MTMON_MAX_BODY_BYTES=6291456
